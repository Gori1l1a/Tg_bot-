# Виртуальное окружение (это тяжелая папка, ее нельзя заливать на GitHub)
venv/
env/
.venv/

# Секреты и переменные (если создашь файл .env с токеном, он не попадет на GitHub)
.env
.env.*

# Системный мусор macOS
.DS_Store

# Кэш Python (создается автоматически при запуске)
__pycache__/
*.py[cod]
*$py.class

# Файлы настроек IDE (VS Code, PyCharm)
.vscode/
.idea/
